{% if collection.description != blank %}

<section class="collection-details-products page-width">
  <div class="collection-details-products__inner">
    
    <!-- LEFT COLUMN -->
    <div class="collection-details-products__left">
      {% if section.settings.show_collection_title %}
        <h2 class="collection-details-products__title">
          {{ collection.title }}
        </h2>
      {% endif %}

      <div class="collection-details-products__description rte">
        {{ collection.description | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' }}
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="collection-details-products__right">
        {% if section.settings.show_collection_title %}
        <h2 class="collection-details-products__title">
          {{ collection.title }} Price List
        </h2>
      {% endif %}
      <div class="collection-details-products__table">

        <!-- Header -->
        <div class="collection-details-products__table-header">
          <div class="collection-details-products__col collection-details-products__col--product tbl-hd">
            {{ section.settings.heading_products | default: 'Products' }}
          </div>
          <div class="collection-details-products__col collection-details-products__col--price tbl-hd">
            {{ section.settings.heading_price | default: 'Price' }}
          </div>
        </div>

        <!-- Rows -->
        {% if collection.products_count > 0 %}
          {% for product in collection.products %}
            <div class="collection-details-products__row">
              <div class="collection-details-products__col collection-details-products__col--product">
                <a href="{{ product.url }}" class="collection-details-products__product-link">
                  {{ product.title }}
                </a>
              </div>
              <div class="collection-details-products__col collection-details-products__col--price">
                {{ product.price | money }}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="collection-details-products__row collection-details-products__row--empty">
            {{ section.settings.no_products_text | default: 'No products available in this collection.' }}
          </div>
        {% endif %}

      </div>
    </div>

  </div>

  <style>
    .collection-details-products {
      margin-top: 3rem;
      margin-Bottom: 3rem; /*for bottom margin*/
      {% comment %} margin-bottom: 3rem; {% endcomment %}
      {% comment %} background: #f5f5f5; {% endcomment %}
      {% comment %} padding: 2rem 1rem; {% endcomment %}
      border-radius: 2px;
    }

    .collection-details-products__inner {
      display: grid;
      gap: 2.5rem;

      background: #f5f5f5;
      padding: 1rem;
    }

    /* Desktop: 70:30 ratio */
    @media screen and (min-width: 750px) {
      .collection-details-products__inner {
        grid-template-columns: 0.65fr 0.35fr;
        align-items: flex-start;
        padding: 5rem; /*for internal padding -desktop*/
      }

      {% comment %} .collection-details-products {
      padding: 4rem;
      max-width: unset;
    } {% endcomment %}
      
    }

    /* Left column */
    .collection-details-products__title {
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .collection-details-products__description {
      margin-bottom: 1.5rem;
      max-width: 97%;
      font-size: 14px;
      line-height: 1.4;
    }

    /* Right column */
    .collection-details-products__table {
      width: 100%;
      font-size: 12px;
    }
    @media screen and (min-width: 1024px) {
      .collection-details-products__table {
        font-size: 14px;
      }
    }
    

    .collection-details-products__table-header,
    .collection-details-products__row {
      display: grid;
      grid-template-columns: 0.7fr 0.3fr;
      gap: 0.8rem;
      padding: 0.75rem 0;
    }

    /* Remove all borders */
    .collection-details-products__table-header,
    .collection-details-products__row,
    .collection-details-products__table {
      border: none !important;
    }

    /* Product link styling */
    .collection-details-products__product-link {
      text-decoration: underline;
      color: inherit;
      line-height: 1.2;
    }

    .collection-details-products__col--price {
      {% comment %} text-align: right; {% endcomment %}
      white-space: nowrap;
      overflow: hidden; /* hide overflow */ 
      text-overflow: ellipsis; /* add ... */ 
      max-width: 100%; /* ensure truncation works */ 
      display: block; /* required for ellipsis in some browsers */
    }

     .tbl-hd{
        font-weight: bold;
    }
    

    /* Mobile */
    @media screen and (max-width: 749px) {
      .collection-details-products__table-header,
      .collection-details-products__row {
        grid-template-columns: 0.7fr 0.3fr;
      }

      .collection-details-products__col--price {
        text-align: left;
        {% comment %} font-weight: bold; {% endcomment %}
      }
    }
  </style>
</section>

{% endif %}

{% schema %}
{
  "name": "Collection footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_products",
      "label": "Heading for products column",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "heading_price",
      "label": "Heading for price column",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "no_products_text",
      "label": "Message when collection has no products",
      "default": "No products available in this collection."
    }
  ],
  "presets": [
    {
      "name": "Collection footer",
      "category": "Collection"
    }
  ]
}
{% endschema %}

